# Copy to .env before deploying. Everything here has a working development default,
# but JWT_SECRET must be changed for anything reachable from the internet.

# Signs the session cookie AND the tokens the games trust. Changing it signs everyone out.
JWT_SECRET=change-me-to-a-long-random-string

# First-run admin account (ignored once the database exists).
ADMIN_EMAIL=admin@mzee.com
ADMIN_PASSWORD=change-me

PORT=3000

# Set in production so the session cookie is only sent over HTTPS.
NODE_ENV=production
